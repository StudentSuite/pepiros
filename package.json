{
  "name": "pepiros-mcp",
  "version": "0.1.0",
  "license": "MIT",
  "description": "MCP server for Pepiros: search, verify, and cite claims against a paper's actual text over stdio -- quote-located grounding, not vector similarity.",
  "repository": {
    "type": "git",
    "url": "https://github.com/StudentSuite/pepiros.git"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "pepiros-mcp": "dist/mcp/stdio.mjs"
  },
  "files": [
    "dist/mcp",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx scripts/seed.ts",
    "mcp:stdio": "tsx --conditions=react-server mcp/stdio.ts",
    "build:mcp": "esbuild mcp/stdio.ts --bundle --platform=node --format=esm --conditions=react-server --external:@modelcontextprotocol/sdk --external:ai --external:zod --external:p-queue --external:@ai-sdk/groq --external:@ai-sdk/openai-compatible --outfile=dist/mcp/stdio.mjs",
    "prepublishOnly": "npm run build:mcp",
    "generate:llms": "tsx scripts/generate-llms-txt.ts",
    "build:brand": "tsx scripts/build-brand.ts",
    "check:no-em-dashes": "tsx scripts/check-no-em-dashes.ts",
    "check:generator-count": "tsx scripts/check-generator-count.ts",
    "index:catalog": "tsx --conditions=react-server scripts/index-catalog.ts"
  },
  "dependencies": {
    "@ai-sdk/groq": "^2.0.47",
    "@ai-sdk/openai-compatible": "^1.0.47",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10",
    "@tiptap/pm": "^2.10.4",
    "@tiptap/react": "^2.10.4",
    "@tiptap/starter-kit": "^2.10.4",
    "@vercel/analytics": "^2.0.1",
    "@xyflow/react": "^12.3.6",
    "ai": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.38.2",
    "framer-motion": "^13.1.0",
    "lucide-react": "^1.31.0",
    "next": "^16.3.1",
    "next-themes": "^0.4.6",
    "p-queue": "^9.3.3",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-pdf": "^9.2.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "jszip": "^3.10.1",
    "postcss": "^8.5.26",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
