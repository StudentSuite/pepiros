{
  "name": "pepiros",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Turns a research PDF into a living knowledge graph where every generated claim is bound to a located quote.",
  "repository": {
    "type": "git",
    "url": "https://github.com/StudentSuite/pepiros.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx scripts/seed.ts",
    "mcp:stdio": "tsx --conditions=react-server mcp/stdio.ts",
    "generate:llms": "tsx scripts/generate-llms-txt.ts"
  },
