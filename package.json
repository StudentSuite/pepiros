    "@tiptap/starter-kit": "^3.29.2",
    "@xyflow/react": "^12.3.6",
    "ai": "^5.0.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.38.2",
    "lucide-react": "^1.31.0",
