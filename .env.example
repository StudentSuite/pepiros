# Supabase (Postgres + Storage + Auth + Realtime) -- add your project's values here
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Drizzle connects directly to Postgres via the Supabase connection string
DATABASE_URL=

# Groq (https://console.groq.com/keys). Model routing per plan.md §3, adapted from
# Anthropic to Groq: a fast/cheap tier for archetype classification + high-volume
# leaf-generator fan-out, a stronger tier for pillar planning + the harder generators
# (methodology, statistical_validity, weaknesses). See lib/ai/client.ts.
GROQ_API_KEY=

# Model ids are env-configurable rather than hardcoded -- Groq's hosted lineup
# changes over time. Defaults (lib/ai/client.ts) if left unset:
#   GROQ_MODEL_FAST=llama-3.1-8b-instant
#   GROQ_MODEL_STRONG=llama-3.3-70b-versatile
# Run `curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"`
# for the current full list this account can use.
GROQ_MODEL_FAST=
GROQ_MODEL_STRONG=

# MCP token signing (mcp/server.ts, mcp_tokens table). Self-generated, not a
# third-party key: any long random string.
MCP_TOKEN_SECRET=

# The app's own origin. MCP results have to carry a deep link back into the
# canvas (plan.md §7: Claude can't see the canvas, so text plus link is the
# whole interface), and nothing else knows what that origin is.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Free, no account required. All three below are courtesy identifiers, not
# --- credentials: the APIs work without them, just in a slower shared pool.

# OpenAlex citation expansion (lib/services/citationExpand.ts). Supplying a
# mailto puts requests in the polite pool instead of the anonymous one.
OPENALEX_MAILTO=

# Crossref DOI resolution on ingest, same polite-pool convention.
CROSSREF_MAILTO=

# Semantic Scholar Related Papers rail (lib/services/related.ts). Genuinely
# optional: unauthenticated access is enough for a demo. Only worth requesting
# a key if the rail starts returning 429.
SEMANTIC_SCHOLAR_API_KEY=
